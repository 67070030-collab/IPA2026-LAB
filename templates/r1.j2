!
! R1 - OSPF in control/data VRF and management-plane protection
!
no ip access-list standard VTY_ALLOWED
ip access-list standard VTY_ALLOWED
 10 permit {{ mgmt_network }}
 20 permit {{ lab306_network }}
 90 deny any log
exit

no ip access-list extended BLOCK_MGMT_PLANE
ip access-list extended BLOCK_MGMT_PLANE
 10 deny ip any {{ mgmt_network }}
 20 permit ip any any
exit

router ospf {{ ospf_process }} vrf {{ control_vrf }}
 passive-interface default
 no passive-interface GigabitEthernet0/2
 log-adjacency-changes
exit

interface GigabitEthernet0/1
 description CONTROL_DATA_TO_UBUNTU_DESKTOP
 ip access-group BLOCK_MGMT_PLANE in
 ip ospf {{ ospf_process }} area 0
 no shutdown
exit

interface GigabitEthernet0/2
 description CONTROL_DATA_TO_R2_G0/1
 ip ospf {{ ospf_process }} area 0
 no shutdown
exit

{% for interface in loopbacks %}
interface {{ interface }}
 ip ospf {{ ospf_process }} area 0
exit
{% endfor %}

line vty 0 15
 access-class VTY_ALLOWED in
 login local
 transport input ssh telnet
 exec-timeout 15 0
exit
